# Backend GraphQL endpoint
VITE_API_URL="http://localhost:4000/graphql"
# Prefix for localStorage / cookie keys
VITE_STORAGE_PREFIX="gogo-admin"
# Optional: Sentry DSN for error reporting (leave empty to disable)
VITE_SENTRY_DSN=""
# "sandbox" shows sandbox-only helpers (simulate deposit etc.), "live" hides them
VITE_BRIDGE_ENV="sandbox"
